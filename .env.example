# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port (Railway sets this automatically)
PORT=3000

# Set to "production" on Railway
NODE_ENV=production

# IndiaMART Pull API Key (get from seller.indiamart.com/leadmanager/crmpushapi → Pull API tab)
INDIAMART_CRM_KEY=your-pull-api-key-here
